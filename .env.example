DGX_AVATAR_DATA_DIR=/home/blockapicoder/dgx-avatar-studio-data
PORT=3010
COMFY_URL=http://127.0.0.1:8188

# Réutilise le cache natif ComfyUI ; "none" rétablit le démarrage historique.
COMFY_CACHE_MODE=auto
# Mettre true pour forcer à nouveau le déchargement avant chaque vidéo Wan.
WAN_FREE_MEMORY_BEFORE_VIDEO=false
# Raccords des vidéos stabilisées : Python ComfyUI avec OpenCV et NumPy.
WAN_TRANSITION_PYTHON=/home/blockapicoder/comfyui-spark/comfyui-env/bin/python

QWEN_BASE_MODEL_BF16=qwen_image_2512_bf16.safetensors
QWEN_EDIT_MODEL_BF16=qwen_image_edit_2511_bf16.safetensors
QWEN_TEXT_ENCODER=qwen_2.5_vl_7b.safetensors
QWEN_VAE=qwen_image_vae.safetensors

TTS_URL=http://127.0.0.1:8880
TTS_MODEL=tts-1-hd-fr
TTS_LANGUAGE=French
TTS_API_KEY=sk-dummy-key
TTS_TIMEOUT_MS=600000

# Dossier input réel de ComfyUI, nécessaire pour charger le WAV dans le workflow
COMFY_INPUT_DIR=/home/blockapicoder/comfyui-spark/ComfyUI/input


# Moteur talking-head plus fidèle au visage source

# Workers ComfyUI utilisés pour le benchmark parallèle
COMFY_BENCH_WORKERS=http://127.0.0.1:8188,http://127.0.0.1:8189,http://127.0.0.1:8190,http://127.0.0.1:8191
