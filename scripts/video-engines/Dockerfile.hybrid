FROM nvcr.io/nvidia/pytorch:25.06-py3

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg libgl1 libglib2.0-0 libsm6 libxext6 libsndfile1 git curl \
    && rm -rf /var/lib/apt/lists/*

# Keep the CUDA/PyTorch stack shipped by NVIDIA for GB10. The remaining
# versions are mutually compatible with LivePortrait and MuseTalk 1.5.
RUN python -m pip install --no-cache-dir \
      "numpy==1.26.4" "opencv-python-headless==4.10.0.84" \
      "scipy==1.13.1" "imageio==2.34.2" "imageio-ffmpeg==0.5.1" \
      "onnx==1.16.1" "onnxruntime>=1.20,<2" \
      "scikit-image==0.24.0" "albumentations==1.4.10" \
      "transformers==4.41.2" "diffusers==0.30.2" "accelerate==0.30.1" \
      "huggingface_hub[cli]==0.30.2" \
      "mmengine==0.10.7" "mmcv-lite==2.1.0" "mmdet==3.3.0" "mmpose==1.3.2" \
      "face-alignment==1.4.1" "librosa==0.11.0" "soundfile==0.12.1" \
      "omegaconf==2.3.0" "einops==0.8.1" "ffmpeg-python==0.2.0" \
      "lmdb==1.4.1" "tqdm==4.66.4" "rich==13.7.1" "tyro==0.8.5" \
      "pykalman==0.9.7" "matplotlib==3.9.0" "moviepy<2" "gdown>=5,<6" \
      "requests>=2.31" "pyyaml==6.0.1" \
    && python -m pip uninstall -y peft \
    && python -m pip cache purge

# MuseTalk uses RTMPose/RTMCC only. MMPose imports EDPose globally even though
# that optional head requires compiled mmcv ops unavailable on GB10/aarch64.
RUN sed -i \
      -e '/from \.transformer_heads import EDPoseHead/d' \
      -e "s/'EDPoseHead',//" \
      /usr/local/lib/python3.12/dist-packages/mmpose/models/heads/__init__.py

WORKDIR /engines
