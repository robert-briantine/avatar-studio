{
  "name": "dgx-avatar-studio",
  "version": "0.7.0-benchmark",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:editor && tsx watch src/server.ts",
    "start": "npm run build:editor && tsx src/server.ts",
    "build": "npm run build:editor && tsc -p tsconfig.json",
    "build:editor": "node scripts/build-code-editor.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "start:prod": "node dist/server.js"
  },
  "dependencies": {
    "@mathjax/src": "^4.1.3",
    "@resvg/resvg-wasm": "2.6.2",
    "@shikijs/monaco": "4.5.0",
    "@tumaet/apollon": "5.4.0",
    "ajv": "8.20.0",
    "express": "^5.1.0",
    "monaco-editor": "0.57.0",
    "multer": "^2.0.2",
    "sharp": "^0.34.3",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.30",
    "esbuild": "0.28.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
